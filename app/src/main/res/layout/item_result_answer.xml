<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/card_question_bg">

    <TextView
        android:id="@+id/tvResultQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Question text goes here"
        android:textColor="@color/text_dark"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvUserAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Your Answer: Paris"
        android:textColor="@color/wrong_answer"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvCorrectAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Correct Answer: London"
        android:textColor="@color/correct_answer"
        android:textSize="14sp" />

</LinearLayout>