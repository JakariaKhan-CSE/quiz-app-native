<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_main_start"
        tools:context=".activity.QuizActivity">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/bg_main_end"
            android:alpha="0.5"
            app:layout_constraintHeight_percent="0.4"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginTop="-80dp"
            android:layout_marginStart="-80dp"
            android:background="@drawable/bg_circle_shape"
            android:backgroundTint="@color/color_primary"
            android:alpha="0.05"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="-50dp"
            android:background="@drawable/bg_circle_shape"
            android:backgroundTint="@color/color_accent"
            android:alpha="0.05"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_circle_shape"
            android:backgroundTint="@color/white"
            android:elevation="4dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_dark"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/color_primary_dark"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvQuestionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="1 / 10"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/quizProgressBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:trackCornerRadius="8dp"
            app:indicatorColor="@color/color_accent"
            app:trackColor="@color/white"
            app:trackThickness="6dp"
            android:progress="10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnBack" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:indeterminateTint="@color/color_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ScrollView
            android:id="@+id/quizContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:fillViewport="true"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/quizProgressBar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="@color/text_dark"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="start"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="What is the specific term used to describe the fear of long words?" />

                <LinearLayout
                    android:id="@+id/linearOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@+id/tvQuestion"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintVertical_bias="0.0">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOption1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:layout_marginBottom="16dp"
                        android:text="Hippopotomonstrosesquippedaliophobia"
                        android:textColor="@color/text_dark"
                        android:backgroundTint="@color/white"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:gravity="center_vertical|start"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:letterSpacing="0.02"
                        android:stateListAnimator="@null"
                        app:elevation="4dp"
                        app:cornerRadius="16dp"
                        app:rippleColor="@color/bg_main_end" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOption2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:layout_marginBottom="16dp"
                        android:text="Arachnophobia"
                        android:textColor="@color/text_dark"
                        android:backgroundTint="@color/white"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:gravity="center_vertical|start"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:letterSpacing="0.02"
                        android:stateListAnimator="@null"
                        app:elevation="4dp"
                        app:cornerRadius="16dp"
                        app:rippleColor="@color/bg_main_end" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOption3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:layout_marginBottom="16dp"
                        android:text="Cynophobia"
                        android:textColor="@color/text_dark"
                        android:backgroundTint="@color/white"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:gravity="center_vertical|start"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:letterSpacing="0.02"
                        android:stateListAnimator="@null"
                        app:elevation="4dp"
                        app:cornerRadius="16dp"
                        app:rippleColor="@color/bg_main_end" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOption4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:layout_marginBottom="32dp"
                        android:text="Acrophobia"
                        android:textColor="@color/text_dark"
                        android:backgroundTint="@color/white"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:gravity="center_vertical|start"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:letterSpacing="0.02"
                        android:stateListAnimator="@null"
                        app:elevation="4dp"
                        app:cornerRadius="16dp"
                        app:rippleColor="@color/bg_main_end" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>