<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_main_start"
        tools:context=".MainActivity">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/bg_main_end"
            android:alpha="0.6"
            app:layout_constraintHeight_percent="0.45"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/circle1"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginTop="-60dp"
            android:layout_marginStart="-60dp"
            android:background="@drawable/bg_circle_shape"
            android:backgroundTint="@color/color_primary"
            android:alpha="0.05"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="-40dp"
            android:background="@drawable/bg_circle_shape"
            android:backgroundTint="@color/color_accent"
            android:alpha="0.05"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imgHero"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:contentDescription="App Logo"
            android:src="@mipmap/ic_launcher"
            android:elevation="12dp"
            app:layout_constraintBottom_toTopOf="@+id/guidelineHorizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.25" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-black"
            android:text="Qurio."
            android:textColor="@color/text_dark"
            android:textSize="56sp"
            android:elevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imgHero" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ignite your intelligence daily."
            android:textColor="@color/text_light"
            android:textSize="16sp"
            android:letterSpacing="0.05"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineHorizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.60" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-32dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="40dp"
            app:cardElevation="24dp"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="@+id/guidelineHorizontal">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="32dp"
                android:paddingBottom="24dp">

                <View
                    android:id="@+id/sheetHandle"
                    android:layout_width="48dp"
                    android:layout_height="5dp"
                    android:background="@drawable/bg_circle_shape"
                    android:backgroundTint="@color/neutral_bg"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStart"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="40dp"
                    android:backgroundTint="@color/btn_primary_solid"
                    android:letterSpacing="0.05"
                    android:text="Start Quiz"
                    android:textAllCaps="false"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null"
                    app:cornerRadius="16dp"
                    app:elevation="8dp"
                    app:icon="@drawable/ic_play_arrow"
                    app:iconGravity="textStart"
                    app:iconPadding="16dp"
                    app:iconSize="24dp"
                    app:layout_constraintTop_toBottomOf="@+id/sheetHandle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecord"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="16dp"
                    android:text="View Statistics"
                    android:textAllCaps="false"
                    android:textColor="@color/color_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_mic"
                    app:iconGravity="textStart"
                    app:iconPadding="16dp"
                    app:iconSize="24dp"
                    app:iconTint="@color/color_primary"
                    app:strokeColor="@color/btn_accent_outlined_stroke"
                    app:strokeWidth="2dp"
                    app:layout_constraintTop_toBottomOf="@+id/btnStart" />

                <TextView
                    android:id="@+id/btnQuit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp"
                    android:text="Exit Application"
                    android:textAllCaps="true"
                    android:textColor="@color/btn_quit_text"
                    android:textSize="13sp"
                    android:letterSpacing="0.15"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btnRecord"
                    app:layout_constraintVertical_bias="1.0" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>