<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_main_start"
        tools:context=".MainActivity">

        <!-- Background Decoration (Optional Gradient Flow) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/bg_main_end"
            android:alpha="0.3"
            app:layout_constraintHeight_percent="0.4"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Decorative Circle behind title -->
        <View
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="-50dp"
            android:layout_marginStart="-50dp"
            android:background="@drawable/bg_circle_shape"
            android:backgroundTint="@color/purple_200"
            android:alpha="0.2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Hero Image -->
        <ImageView
            android:id="@+id/imgHero"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.15"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintBottom_toTopOf="@+id/guidelineHorizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0"
            tools:src="@tools:sample/backgrounds/scenic" />

        <!-- Title Section -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="80dp"
            android:fontFamily="sans-serif-black"
            android:lineSpacingMultiplier="0.85"
            android:text="Qurio."
            android:textColor="@color/color_primary_dark"
            android:textSize="64sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Ignite your intelligence daily."
            android:textColor="@color/text_light"
            android:textSize="18sp"
            android:letterSpacing="0.02"
            app:layout_constraintStart_toStartOf="@+id/tvTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

        <!-- Guideline to split screen 55% / 45% -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineHorizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.55" />

        <!-- Bottom Action Card (Bottom Sheet Style) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-24dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="32dp"
            app:cardElevation="16dp"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="@+id/guidelineHorizontal">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="32dp"
                android:paddingTop="40dp"
                android:paddingEnd="32dp"
                android:paddingBottom="24dp">

                <!-- Decorative handle for bottom sheet look -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:background="@color/neutral_bg"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginBottom="20dp"
                    app:layout_constraintBottom_toTopOf="@+id/btnStart"
                    app:layout_constraintVertical_bias="0.0"
                    />

                <!-- Primary Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStart"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:backgroundTint="@color/btn_primary_solid"
                    android:letterSpacing="0.05"
                    android:text="Start Quiz"
                    android:textAllCaps="false"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:cornerRadius="20dp"
                    app:elevation="8dp"
                    app:icon="@drawable/ic_play_arrow"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:layout_constraintBottom_toTopOf="@+id/btnRecord"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <!-- Secondary Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecord"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="16dp"
                    android:text="Record Stats"
                    android:textAllCaps="false"
                    android:textColor="@color/color_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_mic"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconTint="@color/color_primary"
                    app:strokeColor="@color/btn_accent_outlined_stroke"
                    app:strokeWidth="2dp"
                    app:layout_constraintBottom_toTopOf="@+id/btnQuit"
                    app:layout_constraintTop_toBottomOf="@+id/btnStart" />

                <!-- Tertiary Action (Footer) -->
                <TextView
                    android:id="@+id/btnQuit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp"
                    android:text="Exit Application"
                    android:textAllCaps="true"
                    android:textColor="@color/btn_quit_text"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btnRecord" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>